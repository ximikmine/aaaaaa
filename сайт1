<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Anime Jiggle Lab — WebXR</title>
<style>
  html, body { margin: 0; height: 100%; background: #06060a; overflow: hidden;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #ddd; }
  #overlay {
    position: fixed; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 16px; z-index: 10;
    background: radial-gradient(circle at 50% 30%, #16161e, #06060a 70%);
  }
  #overlay.hidden { display: none; }
  h1 { font-size: 20px; letter-spacing: 2px; color: #ff7eb6; margin: 0; }
  p  { font-size: 12px; color: #888; max-width: 460px; text-align: center; line-height: 1.6; margin: 0; }
  b  { color: #ff6fa8; }
  button {
    background: #ff6fa8; color: #0e0e13; border: 0; padding: 12px 28px;
    border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer;
  }
  button:disabled { opacity: .4; cursor: not-allowed; }
  #hud {
    position: fixed; top: 10px; left: 10px; font-size: 11px; color: #888;
    background: rgba(20,20,28,.8); padding: 6px 10px; border-radius: 8px;
    border: 1px solid #2a2a34; pointer-events: none; z-index: 5;
    font-variant-numeric: tabular-nums;
  }
  #hud .v { color: #ff9ecb; }
</style>
</head>
<body>

<div id="overlay">
  <h1>ANIME JIGGLE LAB · WebXR</h1>
  <p>
    <b>В шлеме:</b> наведи контроллер на картинку и держи <b>Trigger</b>, чтобы «лапать».<br>
    <b>Левый стик</b> — красить маску, <b>правый стик</b> — радиус кисти.<br>
    <b>A</b> сброс · <b>B</b> тряска · <b>X</b> сетка · <b>Y</b> маска.<br>
    <b>Без шлема:</b> мышь = палец, ЛКМ = захват.
  </p>
  <button id="enterBtn" disabled>Загрузка…</button>
</div>

<div id="hud">
  <span>FPS <span class="v" id="fps">—</span></span> ·
  <span>Верш. <span class="v" id="verts">0</span></span> ·
  <span>Режим <span class="v" id="mode">—</span></span>
</div>

<script type="importmap">
{ "imports": { "three": "https://unpkg.com/three@0.160.0/build/three.module.js" } }
</script>

<script type="module">
import * as THREE from 'three';

/* =========================================================
   0. КОНСТАНТЫ
   ========================================================= */
const PLANE_W = 1.6;      // ширина плоскости в метрах
const PLANE_H = 1.0;      // высота
const GRID = 40;          // разрешение сетки (как в оригинале)
const PLANE_Z = -1.6;     // на каком расстоянии от игрока
const PLANE_Y = 1.4;      // высота центра

const IMG_URL = 'image.jpg'; // ← ПОЛОЖИ РЯДОМ картинку с таким именем
                             //   или замени на data:URL / любую ссылку

/* =========================================================
   1. THREE.JS БАЗА
   ========================================================= */
const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.xr.enabled = true;
document.body.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x06060a);

const camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 0.01, 100);
camera.position.set(0, 1.5, 0);

// Свет (для будущих материалов / рук)
scene.add(new THREE.HemisphereLight(0xffffff, 0x222233, 1.2));

/* =========================================================
   2. ТЕКСТУРА-КАРТИНКА + СЕТКА
   ========================================================= */
const geometry = new THREE.PlaneGeometry(PLANE_W, PLANE_H, GRID, GRID);
// НЕ центрируем: оставляем как есть, но запомним rest-позиции
const restPos = geometry.attributes.position.array.slice();

const loader = new THREE.TextureLoader();
const texture = await new Promise((res, rej) => {
  loader.load(IMG_URL, t => { t.colorSpace = THREE.SRGBColorSpace; res(t); }, undefined, rej);
});

const material = new THREE.MeshBasicMaterial({ map: texture, side: THREE.DoubleSide });
const mesh = new THREE.Mesh(geometry, material);
mesh.position.set(0, PLANE_Y, PLANE_Z);
scene.add(mesh);

/* =========================================================
   3. СОСТОЯНИЕ ФИЗИКИ (перенос с оригинала)
   ========================================================= */
const cols = GRID + 1;          // PlaneGeometry: (GRID+1)×(GRID+1) вершин
const rows = GRID + 1;
const N = cols * rows;

const verts = [];               // { bx, by, bvx, bvy, ox, oy, mass, omegaX, omegaY }
const spacingX = PLANE_W / GRID;
const spacingY = PLANE_H / GRID;

for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const i = r * cols + c;
    const ox = restPos[i * 3];      // локальные координаты плоскости (-W/2..W/2)
    const oy = restPos[i * 3 + 1];
    verts.push({
      ox, oy,
      bx: 0, by: 0, bvx: 0, bvy: 0,
      mass: 1 + 0.4 * (r / (rows - 1)) * 2,
      omegaX: 6, omegaY: 6 * (1 - 0.6 * 0.7),
      weight: 1,                    // ← по умолчанию ВСЯ плоскость «мягкая»
    });
  }
}

// Индексы треугольников
const tris = [];
for (let r = 0; r < rows - 1; r++) {
  for (let c = 0; c < cols - 1; c++) {
    const i0 = r * cols + c;
    const i1 = r * cols + c + 1;
    const i2 = (r + 1) * cols + c;
    const i3 = (r + 1) * cols + c + 1;
    tris.push(i0, i1, i2, i1, i3, i2);
  }
}

// Маска (можно рисовать кистью)
const mask = new Float32Array(N).fill(0);
// Для демо — вся плоскость в маске (чтобы сразу можно было лапать):
mask.fill(1);

/* =========================================================
   4. ПАРАМЕТРЫ (как в оригинале)
   ========================================================= */
const cfg = {
  stiffness: 6,
  damping: 0.12,
  gravity: 0.0,           // в 3D гравитация вниз по Y плоскости — оставим 0 для «парения»
  anisotropy: 0.6,
  nonlinear: 0.5,
  massBottom: 0.4,
  grabPower: 0.75,
  grabRadius: 0.22,       // в метрах (≈130px в оригинале)
  edgeFalloff: 0.15,
  maxStretch: 0.15,       // макс смещение вершины в метрах
  meshFix: true,
  invThresh: 0.15,
  smoothMesh: true,
  smoothStr: 0.15,
  timeScale: 1,
};

// Пересчёт omega
function updateOmega() {
  for (const v of verts) {
    v.omegaX = Math.max(0.5, cfg.stiffness);
    v.omegaY = Math.max(0.5, cfg.stiffness * (1 - cfg.anisotropy * 0.7));
  }
}
updateOmega();

/* =========================================================
   5. КОНТРОЛЛЕРЫ (ЛАДОНИ)
   ========================================================= */
const controller0 = renderer.xr.getController(0);
const controller1 = renderer.xr.getController(1);
scene.add(controller0, controller1);

// Визуальная «ладонь» (простой шар + конус)
const handGeo = new THREE.SphereGeometry(0.04, 16, 12);
const handMat = new THREE.MeshBasicMaterial({ color: 0xffd4b3, transparent: true, opacity: 0.85 });
const hand0 = new THREE.Mesh(handGeo, handMat);
const hand1 = new THREE.Mesh(handGeo, handMat);
controller0.add(hand0);
controller1.add(hand1);

// Луч
const rayGeo = new THREE.BufferGeometry().setFromPoints([
  new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 0, -1)
]);
const rayMat = new THREE.LineBasicMaterial({ color: 0xff6fa8, transparent: true, opacity: 0.5 });
controller0.add(new THREE.Line(rayGeo, rayMat));
controller1.add(new THREE.Line(rayGeo, rayMat));

// Состояние рук
const hands = [
  { ctrl: controller0, active: false, point: new THREE.Vector3(), stickX: 0, stickY: 0, buttons: {} },
  { ctrl: controller1, active: false, point: new THREE.Vector3(), stickX: 0, stickY: 0, buttons: {} },
];

controller0.addEventListener('connected', e => { hands[0].gamepad = e.data.gamepad; hands[0].inputSource = e.data; });
controller1.addEventListener('connected', e => { hands[1].gamepad = e.data.gamepad; hands[1].inputSource = e.data; });
controller0.addEventListener('selectstart', () => { hands[0].active = true; });
controller0.addEventListener('selectend',   () => { hands[0].active = false; });
controller1.addEventListener('selectstart', () => { hands[1].active = true; });
controller1.addEventListener('selectend',   () => { hands[1].active = false; });

// Raycaster для попадания по плоскости
const raycaster = new THREE.Raycaster();
const tmpVec = new THREE.Vector3();

function getHandHit(hand) {
  // Берём позицию контроллера и направление -Z
  hand.ctrl.getWorldPosition(tmpVec);
  const dir = new THREE.Vector3(0, 0, -1).applyQuaternion(hand.ctrl.getWorldQuaternion(new THREE.Quaternion()));
  raycaster.set(tmpVec, dir.normalize());
  const hit = raycaster.intersectObject(mesh, false)[0];
  if (!hit) return null;
  // Перевод в локальные координаты плоскости (в метрах)
  const local = mesh.worldToLocal(hit.point.clone());
  // В локальных координатах плоскость: x ∈ [-W/2, W/2], y ∈ [-H/2, H/2]
  return { x: local.x, y: local.y };
}

/* =========================================================
   6. КИСТЬ (рисуем маску стиком)
   ========================================================= */
let brushMode = 'paint';  // paint | erase
let brushRadius = 0.12;   // метры

function applyBrush(hit, mode) {
  if (!hit) return;
  const r2 = brushRadius * brushRadius;
  const inner = brushRadius * 0.5;
  const inner2 = inner * inner;

  for (let i = 0; i < N; i++) {
    const v = verts[i];
    const dx = v.ox - hit.x, dy = v.oy - hit.y;
    const d2 = dx * dx + dy * dy;
    if (d2 > r2) continue;
    let t = 1;
    if (d2 > inner2) {
      const d = Math.sqrt(d2);
      t = 1 - (d - inner) / (brushRadius - inner);
      t = t * t * (3 - 2 * t);
    }
    if (mode === 'paint') mask[i] = Math.min(1, mask[i] + t);
    else mask[i] = Math.max(0, mask[i] - t);
  }
}

/* =========================================================
   7. ФИЗИКА (перенос с оригинала, но в метрах)
   ========================================================= */
function physicsStep(dt) {
  dt = Math.min(dt, 0.05) * cfg.timeScale;

  // Обработка рук: если trigger зажат — «лапаем»
  for (const h of hands) {
    if (h.active) {
      const hit = getHandHit(h);
      if (hit) {
        h.point.set(hit.x, hit.y, 0);
      }
    }
  }

  // Пружины + гравитация по плоскости (только Y-компонента локальной плоскости)
  for (let i = 0; i < N; i++) {
    const v = verts[i];
    if (mask[i] < 0.005) {
      v.bx *= 0.9; v.by *= 0.9; v.bvx *= 0.9; v.bvy *= 0.9;
      continue;
    }

    // Захват: если рука в режиме select и попала по плоскости
    for (const h of hands) {
      if (!h.active || !h.point) continue;
      const dx = h.point.x - (v.ox + v.bx);
      const dy = h.point.y - (v.oy + v.by);
      const d2 = dx * dx + dy * dy;
      const R = cfg.grabRadius;
      if (d2 < R * R) {
        const d = Math.sqrt(d2) || 1e-4;
        const falloff = 1 - d / R;
        const edge = 1 - cfg.edgeFalloff * (1 - mask[i]);
        const k = cfg.grabPower * falloff * falloff * edge;
        v.bx += dx * k;
        v.by += dy * k;
      }
    }

    // Пружина к rest
    const stretch = Math.hypot(v.bx, v.by) / spacingX;
    const nonlin = 1 + cfg.nonlinear * stretch * stretch;
    const w2x = v.omegaX * v.omegaX * nonlin;
    const w2y = v.omegaY * v.omegaY * nonlin;
    const cx = 2 * cfg.damping * v.omegaX;
    const cy = 2 * cfg.damping * v.omegaY;

    let ax = -w2x * v.bx - cx * v.bvx;
    let ay = -w2y * v.by - cy * v.bvy;
    // Гравитация вниз по плоскости (лёгкая, чтобы «отвисало»)
    ay -= 2.0 * mask[i] / v.mass;

    v.bvx += ax * dt; v.bvy += ay * dt;
    v.bx += v.bvx * dt; v.by += v.bvy * dt;

    // Ограничение растяжения
    const mag = Math.hypot(v.bx, v.by);
    if (mag > cfg.maxStretch) {
      v.bx = v.bx / mag * cfg.maxStretch;
      v.by = v.by / mag * cfg.maxStretch;
    }
  }

  if (cfg.meshFix) fixMesh();
  if (cfg.smoothMesh) smoothMesh();
}

// Простой mesh fix: если треугольник вывернулся — тянем обратно
function fixMesh() {
  const pos = geometry.attributes.position.array;
  // Обновляем pos для проверки
  writePositions(pos);
  // Проверка знака площади не нужна в 3D — но проверим сильное сжатие
  // (оставляю упрощённо: если вершина слишком далеко — режем)
  for (let i = 0; i < N; i++) {
    const v = verts[i];
    if (Math.hypot(v.bx, v.by) > cfg.maxStretch * 1.2) {
      v.bx *= 0.7; v.by *= 0.7;
    }
  }
}

function smoothMesh() {
  const blend = cfg.smoothStr;
  if (blend <= 0) return;
  const updates = [];
  for (let r = 1; r < rows - 1; r++) {
    for (let c = 1; c < cols - 1; c++) {
      const i = r * cols + c;
      if (mask[i] < 0.05) continue;
      const v = verts[i];
      let sx = 0, sy = 0, n = 0;
      for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
          if (!dr && !dc) continue;
          const j = (r + dr) * cols + (c + dc);
          sx += verts[j].bx; sy += verts[j].by; n++;
        }
      }
      updates.push({
        v,
        nx: v.bx + (sx / n - v.bx) * blend,
        ny: v.by + (sy / n - v.by) * blend,
      });
    }
  }
  for (const u of updates) { u.v.bx = u.nx; u.v.by = u.ny; }
}

function writePositions(pos) {
  for (let i = 0; i < N; i++) {
    const v = verts[i];
    const w = mask[i];
    pos[i * 3]     = v.ox + v.bx * w;
    pos[i * 3 + 1] = v.oy + v.by * w;
    pos[i * 3 + 2] = 0;
  }
}

/* =========================================================
   8. КНОПКИ НА КОНТРОЛЛЕРАХ
   ========================================================= */
const prevButtons = [ {}, {} ];
function pollButtons() {
  for (let hi = 0; hi < 2; hi++) {
    const h = hands[hi];
    if (!h.gamepad) continue;
    const gp = h.gamepad;
    // Кнопки: 0=trigger, 1=squeeze, 3=A/X, 4=B/Y, 5=thumbstick click
    // Индексы в Quest могут отличаться; используем типичные
    const b3 = gp.buttons[3]?.pressed;
    const b4 = gp.buttons[4]?.pressed;

    if (b3 && !prevButtons[hi].b3) onButtonA(hi);
    if (b4 && !prevButtons[hi].b4) onButtonB(hi);

    prevButtons[hi].b3 = b3;
    prevButtons[hi].b4 = b4;

    // Стики
    const stickX = gp.axes[2] || 0;
    const stickY = gp.axes[3] || 0;

    // Левый стик (hand 0) — красить/стирать
    if (hi === 0 && Math.abs(stickX) > 0.3) {
      const hit = getHandHit(h);
      if (hit) applyBrush(hit, stickX > 0 ? 'paint' : 'erase');
      document.getElementById('mode').textContent = stickX > 0 ? 'paint' : 'erase';
    }
    // Правый стик (hand 1) — радиус кисти
    if (hi === 1 && Math.abs(stickY) > 0.3) {
      brushRadius = Math.max(0.03, Math.min(0.5, brushRadius + stickY * 0.005));
    }
  }
}

function onButtonA(hi) {
  // Сброс
  for (const v of verts) { v.bx = v.by = v.bvx = v.bvy = 0; }
}
function onButtonB(hi) {
  // Тряска
  for (let i = 0; i < N; i++) {
    if (mask[i] < 0.1) continue;
    verts[i].bvx += (Math.random() - 0.5) * 8;
    verts[i].bvy += (Math.random() - 0.5) * 8;
  }
}

/* =========================================================
   9. 2D-ФОЛЛБЭК (мышь / без шлема)
   ========================================================= */
const mouse = new THREE.Vector2();
let mouseDown = false;
let mouseMode = 'grab';
let mouseBrushR = 0.12;

addEventListener('pointerdown', e => {
  mouseDown = true;
  mouse.x = (e.clientX / innerWidth) * 2 - 1;
  mouse.y = -(e.clientY / innerHeight) * 2 + 1;
  if (e.shiftKey) mouseMode = 'paint';
  else if (e.altKey) mouseMode = 'erase';
  else mouseMode = 'grab';
});
addEventListener('pointerup', () => { mouseDown = false; });
addEventListener('pointermove', e => {
  mouse.x = (e.clientX / innerWidth) * 2 - 1;
  mouse.y = -(e.clientY / innerHeight) * 2 + 1;
});
addEventListener('wheel', e => {
  mouseBrushR = Math.max(0.03, Math.min(0.5, mouseBrushR - Math.sign(e.deltaY) * 0.01));
}, { passive: true });

const mouseRay = new THREE.Raycaster();
function getMouseHit() {
  mouseRay.setFromCamera(mouse, camera);
  const hit = mouseRay.intersectObject(mesh, false)[0];
  if (!hit) return null;
  const local = mesh.worldToLocal(hit.point.clone());
  return { x: local.x, y: local.y };
}

/* =========================================================
   10. ГЛАВНЫЙ ЦИКЛ
   ========================================================= */
let last = performance.now();
let fpsAcc = 0, fpsFrames = 0;
const posAttr = geometry.attributes.position;

renderer.setAnimationLoop(() => {
  const now = performance.now();
  const dt = Math.min((now - last) / 1000, 0.05);
  last = now;

  fpsAcc += dt; fpsFrames++;
  if (fpsAcc > 0.5) {
    document.getElementById('fps').textContent = (fpsFrames / fpsAcc).toFixed(0);
    document.getElementById('verts').textContent = N;
    fpsAcc = 0; fpsFrames = 0;
  }

  // XR: обработка кнопок
  if (renderer.xr.isPresenting) {
    pollButtons();
    hands[0].active = hands[0].inputSource?.gamepad?.buttons[0]?.pressed || hands[0].active;
    hands[1].active = hands[1].inputSource?.gamepad?.buttons[0]?.pressed || hands[1].active;
  } else {
    // 2D: мышь
    const hit = getMouseHit();
    for (const h of hands) h.active = false;
    if (hit) {
      if (mouseDown) {
        if (mouseMode === 'grab') {
          hands[0].active = true;
          hands[0].point.set(hit.x, hit.y, 0);
        } else {
          brushRadius = mouseBrushR;
          applyBrush(hit, mouseMode);
        }
      }
    }
  }

  physicsStep(dt);
  writePositions(posAttr.array);
  posAttr.needsUpdate = true;
  geometry.computeVertexNormals();

  // Визуализация «ладони» на контроллере — светится при захвате
  hand0.material.opacity = hands[0].active ? 1.0 : 0.5;
  hand1.material.opacity = hands[1].active ? 1.0 : 0.5;

  renderer.render(scene, camera);
});

/* =========================================================
   11. ВХОД В VR
   ========================================================= */
const enterBtn = document.getElementById('enterBtn');
const overlay = document.getElementById('overlay');

enterBtn.textContent = 'Войти в VR';
enterBtn.disabled = false;

let xrSupported = false;
if (navigator.xr) {
  navigator.xr.isSessionSupported('immersive-vr').then(ok => {
    xrSupported = ok;
    enterBtn.textContent = ok ? 'Войти в VR' : 'VR не поддерживается (2D-режим)';
  });
} else {
  enterBtn.textContent = 'WebXR недоступен — 2D-режим';
}

enterBtn.addEventListener('click', async () => {
  if (xrSupported) {
    try {
      const session = await navigator.xr.requestSession('immersive-vr', {
        optionalFeatures: ['local-floor', 'bounded-floor', 'hand-tracking']
      });
      await renderer.xr.setSession(session);
      overlay.classList.add('hidden');
    } catch (e) {
      alert('Ошибка WebXR: ' + e.message);
    }
  } else {
    overlay.classList.add('hidden'); // просто 2D
  }
});

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

console.log('[Jiggle Lab WebXR] Ready');
</script>
</body>
</html>
